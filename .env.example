# Copy this file to .env.local and fill in the values. .env.local is never committed.
DATABASE_URL=postgres://bookshop:bookshop@127.0.0.1:15432/bookshop

# The address of the site, used for Stripe's "return to shop" links, links in emails and sign-in.
# Open the site at exactly this address (localhost, not 127.0.0.1), or sign-in refuses the request.
SITE_URL=http://localhost:3000

# Stripe test mode: Dashboard → Developers → API keys → Secret key (starts with sk_test_)
STRIPE_SECRET_KEY=aaaaaaaaaaaaaaaa
# Printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook` (starts with whsec_)
STRIPE_WEBHOOK_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaa

# Signs the sign-in cookies, so nobody can forge one. Any long random string. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaa

# "Continue with Google": from Google Cloud Console → Google Auth Platform → Clients.
# Leave them empty and the Google button simply doesn't appear.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where emails go out (SMTP).
# Real inbox: send through your own Gmail account with an app password (needs 2-Step Verification):
#   SMTP_URL=smtps://yourname%40gmail.com:yourapppassword@smtp.gmail.com:465
#   (write the @ of your address as %40, and the app password without spaces)
#   EMAIL_FROM="Bookshop <yourname@gmail.com>"
# Offline: Mailpit from compose.yaml catches everything (read it at http://localhost:8025):
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM="Bookshop <orders@bookshop.test>"
